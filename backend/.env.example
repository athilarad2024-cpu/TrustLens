# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./trustai.db

# PostgreSQL (uncomment and fill in for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/trustai_db

# ── External AI & Security Intelligence ─────────────────────────────────────────
# Google Gemini API Key — https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Safe Browsing API v4 — https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3 — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
UPLOAD_DIR=uploads

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_generate_a_real_secret
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Authentication ─────────────────────────────────────────────────────────────
# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Frontend URL (used in password reset emails) ───────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── HTTP API Email Delivery (Recommended for Render Free Tier over Port 443) ──
# Resend API Key (https://resend.com - 3000 free emails/mo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TrustAI <onboarding@resend.dev>

# Brevo API Key (https://brevo.com - 300 free emails/day)
BREVO_API_KEY=

# SendGrid API Key (https://sendgrid.com)
SENDGRID_API_KEY=

# ── SMTP Email (Note: Render free tier blocks outbound TCP ports 587/465) ──────
# Leave SMTP_HOST blank to use the dev console fallback (prints reset URL to console).
# Fill in real SMTP credentials for production email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@trustai.dev
SMTP_TLS=true
